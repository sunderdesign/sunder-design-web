---
// src/pages/index.astro
import { citasMaestras } from '../data/quotes';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>Sunder Design</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:inline>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body, html {
        width: 100%;
        height: 100dvh;
        overflow: hidden;
        background-color: #111114;
        font-family: "Helvetica Neue", Helvetica, "Hiragino Sans", "PingFang SC", "Noto Sans", "Noto Sans Arabic", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .bg-image {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-repeat: no-repeat;
        z-index: 1;
        background-position: var(--bg-pos, 78% center);
        opacity: 1;
        transition: opacity 0.8s ease-in-out;
        will-change: transform, opacity;
      }

      .bg-image.is-fading {
        opacity: 0;
      }

      /* Selector de idioma superior en la esquina contraria a la frase */
      .lang-topbar {
        position: fixed;
        z-index: 20;
        top: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.45rem;
        max-width: calc(100vw - 2rem);
        pointer-events: auto;
      }

      .pos-left.lang-topbar {
        right: 5.5%;
        left: auto;
        flex-direction: row-reverse;
      }

      .pos-right.lang-topbar {
        left: 5.5%;
        right: auto;
        flex-direction: row;
      }

      .lang-trigger {
        appearance: none;
        -webkit-tap-highlight-color: transparent;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        height: 32px;
        padding: 0 0.7rem 0 0.38rem;
        border-radius: 999px;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        cursor: pointer;
        flex-shrink: 0;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: transform 0.2s ease, background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
      }

      .lang-trigger:hover {
        transform: translateY(-1px);
      }

      .flag-circle {
        width: 19px;
        height: 19px;
        min-width: 19px;
        min-height: 19px;
        max-width: 19px;
        max-height: 19px;
        border-radius: 50%;
        overflow: hidden;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 0 0 1px rgba(128, 128, 128, 0.28);
        background: #222;
      }

      .flag-circle img {
        width: 100%;
        height: 100%;
        max-width: 100%;
        max-height: 100%;
        object-fit: cover;
        display: block;
      }

      .lang-chevron {
        font-size: 0.55rem;
        opacity: 0.75;
        transition: transform 0.25s ease;
      }

      .lang-topbar.is-open .lang-chevron {
        transform: rotate(180deg);
      }

      .lang-drawer {
        display: none;
        align-items: center;
        gap: 0.2rem;
        height: 32px;
        padding: 0 0.32rem;
        border-radius: 999px;
        max-width: min(560px, calc(100vw - 8.5rem));
        overflow: hidden;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        animation: drawerFade 0.2s ease-out forwards;
      }

      .lang-topbar.is-open .lang-drawer {
        display: inline-flex;
      }

      @keyframes drawerFade {
        from { opacity: 0; transform: scaleX(0.95); }
        to { opacity: 1; transform: scaleX(1); }
      }

      .scroll-arrow {
        appearance: none;
        -webkit-tap-highlight-color: transparent;
        border: none;
        background: transparent;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        flex-shrink: 0;
        opacity: 0.8;
        transition: opacity 0.2s ease, background-color 0.2s ease;
      }

      .scroll-arrow:hover {
        opacity: 1;
      }

      .lang-track {
        display: flex;
        align-items: center;
        gap: 0.28rem;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        touch-action: pan-x;
        scroll-behavior: smooth;
        scrollbar-width: none;
        -ms-overflow-style: none;
        padding: 0 0.15rem;
        height: 100%;
      }

      .lang-track::-webkit-scrollbar {
        display: none;
      }

      .lang-pill {
        appearance: none;
        -webkit-tap-highlight-color: transparent;
        border: none;
        background: transparent;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        height: 24px;
        padding: 0 0.52rem 0 0.26rem;
        border-radius: 999px;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        cursor: pointer;
        flex-shrink: 0;
        white-space: nowrap;
        opacity: 0.8;
        transition: opacity 0.18s ease, background-color 0.18s ease, color 0.18s ease;
      }

      .lang-pill:hover {
        opacity: 1;
      }

      .lang-pill.is-active {
        opacity: 1;
        font-weight: 700;
      }

      .lang-pill .flag-circle {
        width: 16px;
        height: 16px;
        min-width: 16px;
        min-height: 16px;
        max-width: 16px;
        max-height: 16px;
      }

      /* Bloque de cita */
      .quote-container {
        position: fixed;
        z-index: 2;
        top: 50%;
        transform: translateY(-50%);
        width: min(470px, 41vw);
        pointer-events: none;
        padding: 1.85rem 2rem;
        border-radius: 14px;
        transition: color 0.5s ease, background 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease;
      }

      .pos-left.quote-container {
        left: 5.5%;
        right: auto;
        text-align: left;
      }

      .pos-right.quote-container {
        right: 5.5%;
        left: auto;
        text-align: left;
      }

      .quote-container[dir="rtl"] {
        text-align: right;
      }

      .quote-text {
        font-family: "Helvetica Neue", Helvetica, "Hiragino Sans", "PingFang SC", "Noto Sans", "Noto Sans Arabic", Arial, sans-serif;
        font-size: clamp(1.22rem, 2.02vw, 1.75rem);
        line-height: 1.4;
        margin-bottom: 1.35rem;
        min-height: 4.1em;
        transition: opacity 0.4s ease, filter 0.4s ease, transform 0.4s ease;
      }

      .typo-bold {
        font-weight: 700;
        letter-spacing: -0.025em;
      }

      .typo-light {
        font-weight: 300;
        letter-spacing: -0.01em;
      }

      .typo-italic {
        font-weight: 500;
        font-style: italic;
        letter-spacing: -0.015em;
      }

      .typo-condensed {
        font-weight: 600;
        letter-spacing: -0.03em;
        font-stretch: condensed;
      }

      .quote-text.is-exiting {
        opacity: 0;
        filter: blur(6px);
        transform: translateY(-6px);
      }

      .typing-cursor::after {
        content: "|";
        display: inline-block;
        margin-inline-start: 2px;
        font-weight: 300;
        animation: blinkCursor 0.8s infinite;
      }

      @keyframes blinkCursor {
        0%, 49% { opacity: 1; }
        50%, 100% { opacity: 0; }
      }

      .word-token {
        display: inline-block;
        opacity: 0;
        transform: translateY(8px);
        filter: blur(4px);
        transition: opacity 0.4s ease, transform 0.4s ease, filter 0.4s ease;
      }

      .word-token.is-shown {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }

      @keyframes blurReveal {
        0% {
          opacity: 0;
          filter: blur(12px);
          transform: translateY(10px);
        }
        100% {
          opacity: 1;
          filter: blur(0);
          transform: translateY(0);
        }
      }

      .anim-blur-reveal {
        animation: blurReveal 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }

      @keyframes clipWipe {
        0% {
          opacity: 0.15;
          clip-path: inset(0 100% 0 0);
        }
        100% {
          opacity: 1;
          clip-path: inset(0 0 0 0);
        }
      }

      .anim-clip-wipe {
        animation: clipWipe 1.1s cubic-bezier(0.25, 1, 0.5, 1) forwards;
      }

      .author-meta {
        display: flex;
        flex-direction: column;
        gap: 0.28rem;
        padding-top: 0.85rem;
        border-top: 1px solid rgba(128, 128, 128, 0.28);
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.55s ease, transform 0.55s ease;
      }

      .author-meta.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      .quote-author {
        font-size: 0.84rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .quote-bio {
        font-size: 0.8rem;
        font-weight: 400;
        line-height: 1.42;
        letter-spacing: 0.01em;
        opacity: 0.9;
      }

      /* Pastilla de correo inferior */
      .footer-bar {
        position: fixed;
        z-index: 3;
        bottom: 2rem;
      }

      .pos-left.footer-bar {
        left: 5.5%;
        right: auto;
      }

      .pos-right.footer-bar {
        right: 5.5%;
        left: auto;
      }

      .contact-link {
        display: inline-block;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-decoration: none;
        padding: 0.64rem 1.12rem;
        border-radius: 8px;
        transition: transform 0.2s ease, background-color 0.3s ease, color 0.3s ease, box-shadow 0.2s ease;
      }

      .contact-link:hover {
        transform: translateY(-2px);
      }

      /* Tema claro */
      .theme-light-text {
        color: #ffffff;
      }

      .theme-light-text.quote-container {
        background: rgba(12, 12, 15, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.16);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
      }

      .theme-light-text .contact-link,
      .theme-light-text .lang-trigger,
      .theme-light-text .lang-drawer {
        background-color: rgba(17, 17, 20, 0.84);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.24);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
      }

      .theme-light-text .contact-link:hover {
        background-color: #ffffff;
        color: #111114;
      }

      .theme-light-text .scroll-arrow,
      .theme-light-text .lang-pill {
        color: #ffffff;
      }

      .theme-light-text .scroll-arrow:hover {
        background-color: rgba(255, 255, 255, 0.14);
      }

      .theme-light-text .lang-pill.is-active {
        background-color: #ffffff;
        color: #111114;
      }

      /* Tema oscuro */
      .theme-dark-text {
        color: #111114;
      }

      .theme-dark-text.quote-container {
        background: rgba(255, 255, 255, 0.84);
        border: 1px solid rgba(0, 0, 0, 0.1);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
      }

      .theme-dark-text .contact-link {
        background-color: #111114;
        color: #ffffff;
        border: 1px solid #111114;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
      }

      .theme-dark-text .contact-link:hover {
        background-color: #2b2b30;
      }

      .theme-dark-text .lang-trigger,
      .theme-dark-text .lang-drawer {
        background-color: rgba(255, 255, 255, 0.9);
        color: #111114;
        border: 1px solid rgba(0, 0, 0, 0.16);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
      }

      .theme-dark-text .scroll-arrow,
      .theme-dark-text .lang-pill {
        color: #111114;
      }

      .theme-dark-text .scroll-arrow:hover {
        background-color: rgba(0, 0, 0, 0.08);
      }

      .theme-dark-text .lang-pill.is-active {
        background-color: #111114;
        color: #ffffff;
      }

      /* Móvil y tablet */
      @media (max-width: 820px) {
        .bg-image {
          inset: 0;
          width: 100%;
          height: 100%;
          background-size: cover;
          background-position: var(--bg-pos-mobile, 80% center);
          transform: scale(1.16) translateY(var(--mob-ty, -12%));
          transform-origin: center center;
        }

        .lang-topbar,
        .pos-left.lang-topbar,
        .pos-right.lang-topbar {
          top: 0.85rem;
          left: 50%;
          right: auto;
          transform: translateX(-50%);
          flex-direction: row-reverse;
          width: 93vw;
          justify-content: flex-start;
        }

        .lang-trigger {
          height: 36px;
          padding: 0 0.8rem 0 0.45rem;
          font-size: 0.78rem;
        }

        .lang-drawer {
          height: 36px;
          max-width: calc(93vw - 5.2rem);
          padding: 0 0.35rem;
        }

        .scroll-arrow {
          width: 28px;
          height: 28px;
          font-size: 1rem;
        }

        .lang-pill {
          height: 28px;
          padding: 0 0.6rem 0 0.3rem;
          font-size: 0.74rem;
        }

        .quote-container,
        .pos-left.quote-container,
        .pos-right.quote-container {
          top: auto;
          bottom: 4.1rem;
          left: 50%;
          right: auto;
          transform: translateX(-50%);
          width: 91vw;
          max-width: 490px;
          text-align: center;
          padding: 0.95rem 1.2rem;
          border-radius: 14px;
        }

        .quote-container[dir="rtl"] {
          text-align: center;
        }

        .quote-text {
          font-size: clamp(1.04rem, 4.1vw, 1.28rem);
          line-height: 1.34;
          min-height: 2.8em;
          margin-bottom: 0.65rem;
        }

        .author-meta {
          padding-top: 0.55rem;
          gap: 0.18rem;
        }

        .quote-author {
          font-size: 0.74rem;
        }

        .quote-bio {
          font-size: 0.71rem;
          line-height: 1.3;
        }

        .theme-light-text.quote-container {
          background: rgba(12, 12, 15, 0.76);
        }

        .theme-dark-text.quote-container {
          background: rgba(255, 255, 255, 0.86);
        }

        .footer-bar,
        .pos-left.footer-bar,
        .pos-right.footer-bar {
          bottom: 0.95rem;
          left: 50%;
          right: auto;
          transform: translateX(-50%);
          width: 100%;
          text-align: center;
        }

        .contact-link {
          font-size: 0.76rem;
          padding: 0.5rem 0.95rem;
        }
      }
    </style>
  </head>
  <body>
    <div id="bg" class="bg-image"></div>

    <header id="lang-topbar" class="lang-topbar">
      <button type="button" id="lang-trigger" class="lang-trigger" aria-expanded="false" aria-label="Cambiar idioma">
        <span class="flag-circle"><img id="current-flag" width="19" height="19" alt="" /></span>
        <span id="current-badge">ES</span>
        <span class="lang-chevron">▼</span>
      </button>

      <div id="lang-drawer" class="lang-drawer" role="region" aria-label="Idiomas">
        <button type="button" id="lang-prev" class="scroll-arrow" aria-label="Anterior">‹</button>
        <div id="lang-track" class="lang-track"></div>
        <button type="button" id="lang-next" class="scroll-arrow" aria-label="Siguiente">›</button>
      </div>
    </header>

    <aside id="quote-container" class="quote-container">
      <p id="quote-text" class="quote-text"></p>
      <div id="author-meta" class="author-meta">
        <span id="quote-author" class="quote-author"></span>
        <span id="quote-bio" class="quote-bio"></span>
      </div>
    </aside>

    <footer id="footer-bar" class="footer-bar">
      <a href="mailto:think@sunder.design" class="contact-link">think@sunder.design</a>
    </footer>

    <script is:inline define:vars={{ citasMaestras }}>
      const idiomasCatalogo = [
        { code: 'es', badge: 'ES', flag: 'es', mm: 'es-ES', g: 'es' },
        { code: 'en', badge: 'GB', flag: 'gb', mm: 'en-GB', g: 'en' },
        { code: 'fr', badge: 'FR', flag: 'fr', mm: 'fr-FR', g: 'fr' },
        { code: 'de', badge: 'DE', flag: 'de', mm: 'de-DE', g: 'de' },
        { code: 'it', badge: 'IT', flag: 'it', mm: 'it-IT', g: 'it' },
        { code: 'pt', badge: 'PT', flag: 'pt', mm: 'pt-PT', g: 'pt' },
        { code: 'ru', badge: 'RU', flag: 'ru', mm: 'ru-RU', g: 'ru' },
        { code: 'ar', badge: 'MA', flag: 'ma', mm: 'ar-MA', g: 'ar', rtl: true },
        { code: 'zgh', badge: 'DZ', flag: 'dz', mm: 'kab-DZ', g: 'ber' },
        { code: 'zh', badge: 'CN', flag: 'cn', mm: 'zh-CN', g: 'zh-CN' },
        { code: 'ja', badge: 'JP', flag: 'jp', mm: 'ja-JP', g: 'ja' },
        { code: 'ko', badge: 'KR', flag: 'kr', mm: 'ko-KR', g: 'ko' },
        { code: 'hi', badge: 'IN', flag: 'in', mm: 'hi-IN', g: 'hi' },
        { code: 'bn', badge: 'BD', flag: 'bd', mm: 'bn-BD', g: 'bn' },
        { code: 'ur', badge: 'PK', flag: 'pk', mm: 'ur-PK', g: 'ur', rtl: true },
        { code: 'id', badge: 'ID', flag: 'id', mm: 'id-ID', g: 'id' },
        { code: 'tr', badge: 'TR', flag: 'tr', mm: 'tr-TR', g: 'tr' },
        { code: 'vi', badge: 'VN', flag: 'vn', mm: 'vi-VN', g: 'vi' },
        { code: 'fa', badge: 'IR', flag: 'ir', mm: 'fa-IR', g: 'fa', rtl: true },
        { code: 'sw', badge: 'KE', flag: 'ke', mm: 'sw-KE', g: 'sw' },
        { code: 'ca', badge: 'AD', flag: 'ad', mm: 'ca-ES', g: 'ca' },
        { code: 'eu', badge: 'EU', flag: 'es-pv', mm: 'eu-ES', g: 'eu' },
        { code: 'gl', badge: 'GL', flag: 'es-ga', mm: 'gl-ES', g: 'gl' },
        { code: 'nl', badge: 'NL', flag: 'nl', mm: 'nl-NL', g: 'nl' },
        { code: 'pl', badge: 'PL', flag: 'pl', mm: 'pl-PL', g: 'pl' },
        { code: 'uk', badge: 'UA', flag: 'ua', mm: 'uk-UA', g: 'uk' },
        { code: 'be', badge: 'BY', flag: 'by', mm: 'be-BY', g: 'be' },
        { code: 'ro', badge: 'RO', flag: 'ro', mm: 'ro-RO', g: 'ro' },
        { code: 'el', badge: 'GR', flag: 'gr', mm: 'el-GR', g: 'el' },
        { code: 'cs', badge: 'CZ', flag: 'cz', mm: 'cs-CZ', g: 'cs' },
        { code: 'sk', badge: 'SK', flag: 'sk', mm: 'sk-SK', g: 'sk' },
        { code: 'hu', badge: 'HU', flag: 'hu', mm: 'hu-HU', g: 'hu' },
        { code: 'sv', badge: 'SE', flag: 'se', mm: 'sv-SE', g: 'sv' },
        { code: 'no', badge: 'NO', flag: 'no', mm: 'nb-NO', g: 'no' },
        { code: 'da', badge: 'DK', flag: 'dk', mm: 'da-DK', g: 'da' },
        { code: 'fi', badge: 'FI', flag: 'fi', mm: 'fi-FI', g: 'fi' },
        { code: 'is', badge: 'IS', flag: 'is', mm: 'is-IS', g: 'is' },
        { code: 'bg', badge: 'BG', flag: 'bg', mm: 'bg-BG', g: 'bg' },
        { code: 'sr', badge: 'RS', flag: 'rs', mm: 'sr-RS', g: 'sr' },
        { code: 'hr', badge: 'HR', flag: 'hr', mm: 'hr-HR', g: 'hr' },
        { code: 'sl', badge: 'SI', flag: 'si', mm: 'sl-SI', g: 'sl' },
        { code: 'lt', badge: 'LT', flag: 'lt', mm: 'lt-LT', g: 'lt' },
        { code: 'lv', badge: 'LV', flag: 'lv', mm: 'lv-LV', g: 'lv' },
        { code: 'et', badge: 'EE', flag: 'ee', mm: 'et-EE', g: 'et' },
        { code: 'sq', badge: 'AL', flag: 'al', mm: 'sq-AL', g: 'sq' },
        { code: 'ga', badge: 'IE', flag: 'ie', mm: 'ga-IE', g: 'ga' },
        { code: 'mt', badge: 'MT', flag: 'mt', mm: 'mt-MT', g: 'mt' },
        { code: 'kk', badge: 'KZ', flag: 'kz', mm: 'kk-KZ', g: 'kk' }
      ];

      function getFlagUrl(flagCode) {
        return 'https://hatscripts.github.io/circle-flags/flags/' + flagCode + '.svg';
      }

      const rtlSet = new Set(idiomasCatalogo.filter((i) => i.rtl).map((i) => i.code));
      const noSpaceSet = new Set(['zh', 'ja']);

      const fondos = [
        { src: '/bck_00.jpg',  side: 'left',  theme: 'theme-dark-text',  bgPos: '80% center', bgPosMobile: '82% center', mobTy: '-12%' },
        { src: '/bck_01.jpg',  side: 'left',  theme: 'theme-light-text', bgPos: '78% center', bgPosMobile: '80% center', mobTy: '-12%' },
        { src: '/bck_02.jpg',  side: 'left',  theme: 'theme-dark-text',  bgPos: '78% center', bgPosMobile: '80% center', mobTy: '-12%' },
        { src: '/bck_03.jpg',  side: 'left',  theme: 'theme-light-text', bgPos: '76% center', bgPosMobile: '78% center', mobTy: '-12%' },
        { src: '/bck_04.jpeg', side: 'left',  theme: 'theme-dark-text',  bgPos: '78% center', bgPosMobile: '78% center', mobTy: '-12%' },
        { src: '/bck_05.jpeg', side: 'right', theme: 'theme-light-text', bgPos: '22% center', bgPosMobile: '22% center', mobTy: '-12%' },
        { src: '/bck_06.jpeg', side: 'right', theme: 'theme-light-text', bgPos: '20% center', bgPosMobile: '20% center', mobTy: '-12%' },
        { src: '/bck_07.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '78% center', bgPosMobile: '78% center', mobTy: '-12%' },
        { src: '/bck_08.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '78% center', bgPosMobile: '78% center', mobTy: '-12%' },
        { src: '/bck_09.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '76% center', bgPosMobile: '76% center', mobTy: '-12%' },
        { src: '/bck_10.jpeg', side: 'left',  theme: 'theme-dark-text',  bgPos: '78% center', bgPosMobile: '78% center', mobTy: '-12%' },
        { src: '/bck_11.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '78% center', bgPosMobile: '78% center', mobTy: '-12%' },
        { src: '/bck_12.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '78% center', bgPosMobile: '78% center', mobTy: '-12%' },
        { src: '/bck_13.jpeg', side: 'right', theme: 'theme-dark-text',  bgPos: '22% center', bgPosMobile: '22% center', mobTy: '-12%' },
        { src: '/bck_14.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '78% center', bgPosMobile: '78% center', mobTy: '-12%' },
        { src: '/bck_15.jpeg', side: 'right', theme: 'theme-light-text', bgPos: '22% center', bgPosMobile: '22% center', mobTy: '-12%' },
        { src: '/bck_16.jpeg', side: 'left',  theme: 'theme-dark-text',  bgPos: '80% center', bgPosMobile: '80% center', mobTy: '-12%' },
        { src: '/bck_17.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '80% center', bgPosMobile: '80% center', mobTy: '-12%' },
        { src: '/bck_18.jpeg', side: 'right', theme: 'theme-dark-text',  bgPos: '20% center', bgPosMobile: '20% center', mobTy: '-12%' },
        { src: '/bck_19.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '78% center', bgPosMobile: '78% center', mobTy: '-12%' },
        { src: '/bck_20.jpeg', side: 'right', theme: 'theme-dark-text',  bgPos: '20% center', bgPosMobile: '20% center', mobTy: '-12%' },
        { src: '/bck_21.jpeg', side: 'left',  theme: 'theme-dark-text',  bgPos: '78% center', bgPosMobile: '78% center', mobTy: '-12%' }
      ];

      const idiomasSoportados = idiomasCatalogo.map((i) => i.code);

      function detectarIdiomaInicial() {
        const params = new URLSearchParams(window.location.search);
        const queryLang = (params.get('lang') || '').toLowerCase().trim();
        if (idiomasSoportados.includes(queryLang)) return queryLang;
        if (idiomasSoportados.includes(queryLang.slice(0, 2))) return queryLang.slice(0, 2);

        try {
          const savedLang = (localStorage.getItem('sunder_user_lang') || '').toLowerCase().trim();
          if (idiomasSoportados.includes(savedLang)) return savedLang;
        } catch (e) {}

        const navLangs = Array.isArray(navigator.languages) && navigator.languages.length
          ? navigator.languages
          : [navigator.language || 'en'];

        for (const lang of navLangs) {
          const full = String(lang).toLowerCase();
          if (idiomasSoportados.includes(full)) return full;
          const shortCode = full.slice(0, 2);
          if (idiomasSoportados.includes(shortCode)) return shortCode;
        }

        return 'en';
      }

      let idiomaActivo = detectarIdiomaInicial();
      let citaActualIdx = 0;

      const variantesHelvetica = ['typo-bold', 'typo-light', 'typo-italic', 'typo-condensed'];
      let animTimers = [];
      let nextSceneTimer = null;
      let animIndex = 0;
      let renderTicket = 0;

      let cacheTraducciones = {};
      try {
        cacheTraducciones = JSON.parse(localStorage.getItem('sunder_i18n_cache_v2') || '{}');
      } catch (e) {
        cacheTraducciones = {};
      }

      function guardarCache() {
        try {
          localStorage.setItem('sunder_i18n_cache_v2', JSON.stringify(cacheTraducciones));
        } catch (e) {}
      }

      // Doble motor de traducción compatible con Safari/iOS y navegadores móviles
      async function traducirTexto(textoOriginal, targetCode) {
        if (!textoOriginal || targetCode === 'es') return textoOriginal;

        const cacheKey = targetCode + '::' + textoOriginal;
        if (cacheTraducciones[cacheKey]) {
          return cacheTraducciones[cacheKey];
        }

        const langObj = idiomasCatalogo.find((i) => i.code === targetCode) || { mm: targetCode, g: targetCode };

        // Motor 1: MyMemory API (CORS abierto, sin bloqueos en iOS Safari)
        try {
          const mmUrl =
            'https://api.mymemory.translated.net/get?q=' +
            encodeURIComponent(textoOriginal) +
            '&langpair=es-ES|' +
            encodeURIComponent(langObj.mm);

          const res = await fetch(mmUrl);
          if (res.ok) {
            const data = await res.json();
            const trad = data && data.responseData && data.responseData.translatedText;
            if (trad && typeof trad === 'string' && trad.trim().toLowerCase() !== textoOriginal.trim().toLowerCase()) {
              cacheTraducciones[cacheKey] = trad.trim();
              guardarCache();
              return trad.trim();
            }
          }
        } catch (e1) {}

        // Motor 2 (Respaldo): Google GTX endpoint
        try {
          const gUrl =
            'https://translate.googleapis.com/translate_a/single?client=gtx&sl=es&tl=' +
            encodeURIComponent(langObj.g) +
            '&dt=t&q=' +
            encodeURIComponent(textoOriginal);

          const res2 = await fetch(gUrl);
          if (res2.ok) {
            const data2 = await res2.json();
            if (Array.isArray(data2) && Array.isArray(data2[0])) {
              const trad2 = data2[0].map((part) => (part && part[0] ? part[0] : '')).join('').trim();
              if (trad2 && trad2.toLowerCase() !== textoOriginal.trim().toLowerCase()) {
                cacheTraducciones[cacheKey] = trad2;
                guardarCache();
                return trad2;
              }
            }
          }
        } catch (e2) {}

        return textoOriginal;
      }

      async function obtenerCitaTraducida(idx, targetCode) {
        const base = citasMaestras[idx];
        if (!base) return { texto: '', autor: '', bio: '' };
        if (targetCode === 'es') {
          return { texto: base.texto, autor: base.autor, bio: base.bio };
        }

        const [textoTrad, bioTrad] = await Promise.all([
          traducirTexto(base.texto, targetCode),
          traducirTexto(base.bio, targetCode)
        ]);

        return {
          texto: textoTrad,
          autor: base.autor,
          bio: bioTrad
        };
      }

      function actualizarUIIdioma() {
        document.documentElement.lang = idiomaActivo;
        const containerEl = document.getElementById('quote-container');
        if (containerEl) {
          containerEl.setAttribute('dir', rtlSet.has(idiomaActivo) ? 'rtl' : 'ltr');
        }

        const actual = idiomasCatalogo.find((i) => i.code === idiomaActivo) || idiomasCatalogo[0];
        const flagEl = document.getElementById('current-flag');
        const badgeEl = document.getElementById('current-badge');
        if (flagEl) {
          flagEl.src = getFlagUrl(actual.flag);
          flagEl.alt = actual.badge;
        }
        if (badgeEl) {
          badgeEl.textContent = actual.badge;
        }

        document.querySelectorAll('#lang-track .lang-pill').forEach((pill) => {
          const isActive = pill.getAttribute('data-lang') === idiomaActivo;
          pill.classList.toggle('is-active', isActive);
          if (isActive) {
            pill.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }
        });
      }

      function construirBarraIdiomas() {
        const trackEl = document.getElementById('lang-track');
        if (!trackEl) return;
        trackEl.innerHTML = '';

        idiomasCatalogo.forEach((item) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'lang-pill' + (item.code === idiomaActivo ? ' is-active' : '');
          btn.setAttribute('data-lang', item.code);

          const circle = document.createElement('span');
          circle.className = 'flag-circle';
          const img = document.createElement('img');
          img.src = getFlagUrl(item.flag);
          img.alt = item.badge;
          img.width = 16;
          img.height = 16;
          img.loading = 'lazy';
          circle.appendChild(img);

          const label = document.createElement('span');
          label.textContent = item.badge;

          btn.appendChild(circle);
          btn.appendChild(label);

          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            if (item.code === idiomaActivo) {
              cerrarDesplegable();
              return;
            }
            idiomaActivo = item.code;
            try {
              localStorage.setItem('sunder_user_lang', idiomaActivo);
            } catch (err) {}

            actualizarUIIdioma();
            cerrarDesplegable();
            limpiarTimers();

            // Asegura que el fondo siga visible aunque estuviera en transición
            const bgEl = document.getElementById('bg');
            if (bgEl) bgEl.classList.remove('is-fading');

            const textEl = document.getElementById('quote-text');
            const metaEl = document.getElementById('author-meta');
            if (textEl) {
              textEl.className = 'quote-text typo-light';
              textEl.textContent = '···';
            }
            if (metaEl) metaEl.classList.remove('is-visible');

            const ticket = ++renderTicket;
            const citaTraducida = await obtenerCitaTraducida(citaActualIdx, idiomaActivo);
            if (ticket !== renderTicket) return;

            mostrarFraseAnimada(envolverConComillas(citaTraducida.texto), citaTraducida.autor, citaTraducida.bio);
          });

          trackEl.appendChild(btn);
        });
      }

      function abrirDesplegable() {
        const topbar = document.getElementById('lang-topbar');
        const trigger = document.getElementById('lang-trigger');
        if (!topbar || !trigger) return;
        topbar.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
        const activePill = document.querySelector('#lang-track .lang-pill.is-active');
        if (activePill) {
          activePill.scrollIntoView({ behavior: 'auto', block: 'nearest', inline: 'center' });
        }
      }

      function cerrarDesplegable() {
        const topbar = document.getElementById('lang-topbar');
        const trigger = document.getElementById('lang-trigger');
        if (!topbar || !trigger) return;
        topbar.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      }

      function limpiarTimers() {
        animTimers.forEach((id) => clearTimeout(id));
        animTimers = [];
        if (nextSceneTimer) {
          clearTimeout(nextSceneTimer);
          nextSceneTimer = null;
        }
      }

      function crearCicloBarajado(total, prohibidoAlInicio) {
        const arr = Array.from({ length: total }, (_, i) => i);
        for (let i = arr.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        if (total > 1 && arr[0] === prohibidoAlInicio) {
          const swapIdx = 1 + Math.floor(Math.random() * (total - 1));
          [arr[0], arr[swapIdx]] = [arr[swapIdx], arr[0]];
        }
        return arr;
      }

      function obtenerSiguienteDeCola(queueKey, lastKey, total) {
        let cola = [];
        let ultimo = -1;
        try {
          cola = JSON.parse(localStorage.getItem(queueKey) || '[]');
          ultimo = parseInt(localStorage.getItem(lastKey) || '-1', 10);
        } catch (e) {
          cola = [];
          ultimo = -1;
        }

        const colaValida =
          Array.isArray(cola) &&
          cola.length <= total &&
          cola.every((n) => Number.isInteger(n) && n >= 0 && n < total);

        if (!colaValida || cola.length === 0) {
          cola = crearCicloBarajado(total, ultimo);
        }

        const elegidoIdx = cola.shift();
        try {
          localStorage.setItem(queueKey, JSON.stringify(cola));
          localStorage.setItem(lastKey, String(elegidoIdx));
        } catch (e) {}

        return elegidoIdx;
      }

      function obtenerSiguienteFondo() {
        const idx = obtenerSiguienteDeCola('sunder_bg_queue', 'sunder_bg_last', fondos.length);
        return fondos[idx];
      }

      function envolverConComillas(texto) {
        if (noSpaceSet.has(idiomaActivo)) return '「' + texto + '」';
        if (idiomaActivo === 'fr' || idiomaActivo === 'ru' || idiomaActivo === 'uk' || idiomaActivo === 'be' || idiomaActivo === 'kk') {
          return '«' + texto + '»';
        }
        return '“' + texto + '”';
      }

      function mostrarFraseAnimada(texto, autor, bio) {
        const textEl = document.getElementById('quote-text');
        const metaEl = document.getElementById('author-meta');
        const authorEl = document.getElementById('quote-author');
        const bioEl = document.getElementById('quote-bio');
        if (!textEl || !metaEl || !authorEl || !bioEl) return;

        const esNoLatino = noSpaceSet.has(idiomaActivo) || rtlSet.has(idiomaActivo);
        const varianteTipografica = esNoLatino
          ? (animIndex % 2 === 0 ? 'typo-bold' : 'typo-light')
          : variantesHelvetica[animIndex % variantesHelvetica.length];

        textEl.className = 'quote-text ' + varianteTipografica;
        textEl.innerHTML = '';
        metaEl.classList.remove('is-visible');
        authorEl.textContent = autor;
        bioEl.textContent = bio;

        const modo = animIndex % 4;
        animIndex++;

        let duracionAnimacion = 1200;

        if (modo === 0) {
          textEl.classList.add('typing-cursor');
          let i = 0;
          duracionAnimacion = texto.length * 32;
          const teclear = () => {
            if (i < texto.length) {
              textEl.textContent += texto.charAt(i);
              i++;
              animTimers.push(setTimeout(teclear, 24 + Math.random() * 18));
            } else {
              metaEl.classList.add('is-visible');
            }
          };
          teclear();
        } else if (modo === 1) {
          // Solo tokenizar por carácter si realmente no hay espacios en la frase
          const sinEspacios = noSpaceSet.has(idiomaActivo) && !texto.includes(' ');
          const tokens = sinEspacios ? Array.from(texto) : texto.split(' ');
          const pasoMs = sinEspacios ? 35 : 75;
          duracionAnimacion = tokens.length * pasoMs + 300;
          tokens.forEach((token, idx) => {
            const span = document.createElement('span');
            span.className = 'word-token';
            span.textContent = token;
            textEl.appendChild(span);
            if (!sinEspacios && idx < tokens.length - 1) {
              textEl.appendChild(document.createTextNode(' '));
            }

            animTimers.push(setTimeout(() => {
              span.classList.add('is-shown');
              if (idx === tokens.length - 1) {
                animTimers.push(setTimeout(() => metaEl.classList.add('is-visible'), 200));
              }
            }, idx * pasoMs));
          });
        } else if (modo === 2) {
          textEl.textContent = texto;
          void textEl.offsetWidth;
          textEl.classList.add('anim-blur-reveal');
          animTimers.push(setTimeout(() => metaEl.classList.add('is-visible'), 550));
        } else {
          textEl.textContent = texto;
          void textEl.offsetWidth;
          textEl.classList.add('anim-clip-wipe');
          animTimers.push(setTimeout(() => metaEl.classList.add('is-visible'), 600));
        }

        const tiempoLectura = Math.max(10500, Math.min(15000, duracionAnimacion + 9000));
        nextSceneTimer = setTimeout(() => aplicarEscena(true), tiempoLectura);
      }

      async function aplicarEscena(conTransicion) {
        limpiarTimers();
        const ticket = ++renderTicket;

        const elegido = obtenerSiguienteFondo();
        citaActualIdx = obtenerSiguienteDeCola(
          'sunder_quotes_queue',
          'sunder_quotes_last',
          citasMaestras.length
        );

        const bgEl = document.getElementById('bg');
        const containerEl = document.getElementById('quote-container');
        const footerEl = document.getElementById('footer-bar');
        const topbarEl = document.getElementById('lang-topbar');
        const textEl = document.getElementById('quote-text');
        const metaEl = document.getElementById('author-meta');

        if (!bgEl || !containerEl || !footerEl || !topbarEl || !textEl || !metaEl) return;

        const promesaCita = obtenerCitaTraducida(citaActualIdx, idiomaActivo);

        const actualizarDOM = async () => {
          const cita = await promesaCita;
          if (ticket !== renderTicket) return;

          bgEl.style.backgroundImage = "url('" + elegido.src + "')";
          bgEl.style.setProperty('--bg-pos', elegido.bgPos);
          bgEl.style.setProperty('--bg-pos-mobile', elegido.bgPosMobile);
          bgEl.style.setProperty('--mob-ty', elegido.mobTy);

          containerEl.classList.remove('theme-light-text', 'theme-dark-text', 'pos-left', 'pos-right');
          footerEl.classList.remove('theme-light-text', 'theme-dark-text', 'pos-left', 'pos-right');
          topbarEl.classList.remove('theme-light-text', 'theme-dark-text', 'pos-left', 'pos-right');

          const sideClass = elegido.side === 'right' ? 'pos-right' : 'pos-left';
          containerEl.classList.add(elegido.theme, sideClass);
          footerEl.classList.add(elegido.theme, sideClass);
          topbarEl.classList.add(elegido.theme, sideClass);

          if (conTransicion) {
            bgEl.classList.remove('is-fading');
          }

          actualizarUIIdioma();
          mostrarFraseAnimada(envolverConComillas(cita.texto), cita.autor, cita.bio);
        };

        if (conTransicion) {
          metaEl.classList.remove('is-visible');
          textEl.classList.add('is-exiting');

          const preloader = new Image();
          preloader.src = elegido.src;
          bgEl.classList.add('is-fading');

          let ejecutado = false;
          const finalizar = () => {
            if (ejecutado) return;
            ejecutado = true;
            setTimeout(actualizarDOM, 420);
          };

          preloader.onload = finalizar;
          preloader.onerror = finalizar;
          setTimeout(finalizar, 850);
        } else {
          await actualizarDOM();
        }
      }

      const triggerBtn = document.getElementById('lang-trigger');
      const prevBtn = document.getElementById('lang-prev');
      const nextBtn = document.getElementById('lang-next');
      const trackEl = document.getElementById('lang-track');

      if (triggerBtn) {
        triggerBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const topbar = document.getElementById('lang-topbar');
          if (topbar && topbar.classList.contains('is-open')) {
            cerrarDesplegable();
          } else {
            abrirDesplegable();
          }
        });
      }

      if (prevBtn && trackEl) {
        prevBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          trackEl.scrollBy({ left: -200, behavior: 'smooth' });
        });
      }

      if (nextBtn && trackEl) {
        nextBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          trackEl.scrollBy({ left: 200, behavior: 'smooth' });
        });
      }

      document.addEventListener('click', (e) => {
        const topbar = document.getElementById('lang-topbar');
        if (topbar && !topbar.contains(e.target)) {
          cerrarDesplegable();
        }
      });

      construirBarraIdiomas();
      actualizarUIIdioma();
      aplicarEscena(false);

      window.addEventListener('pageshow', (event) => {
        if (event.persisted) {
          aplicarEscena(false);
        }
      });
    </script>
  </body>
