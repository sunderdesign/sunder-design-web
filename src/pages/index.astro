---
// src/pages/index.astro
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sunder Design</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body, html {
        width: 100%;
        height: 100dvh;
        overflow: hidden;
        background-color: #111;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }

      .bg-image {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-repeat: no-repeat;
        z-index: 1;
        background-position: var(--bg-pos, 72% center);
        transition: opacity 0.5s ease;
      }

      /* Bloque tipográfico integrado en el espacio libre de la izquierda */
      .quote-container {
        position: fixed;
        z-index: 2;
        top: 50%;
        left: 7%;
        transform: translateY(-50%);
        width: min(440px, 44vw);
        text-align: left;
        pointer-events: none;
      }

      .quote-kicker {
        display: block;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        margin-bottom: 1rem;
        opacity: 0.65;
      }

      .quote-text {
        font-size: clamp(1.25rem, 2.3vw, 1.85rem);
        font-weight: 300;
        line-height: 1.42;
        letter-spacing: -0.01em;
        margin-bottom: 1.1rem;
      }

      .quote-sub {
        display: block;
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.7;
      }

      /* Pie de página con enlace de contacto */
      .footer-contact {
        position: fixed;
        z-index: 3;
        bottom: 2rem;
        left: 7%;
      }

      .contact-link {
        font-size: 0.85rem;
        font-weight: 400;
        letter-spacing: 0.12em;
        text-decoration: none;
        color: inherit;
        opacity: 0.75;
        border-bottom: 1px solid currentColor;
        padding-bottom: 3px;
        transition: opacity 0.25s ease;
      }

      .contact-link:hover {
        opacity: 1;
      }

      /* Tema claro (texto blanco sobre fondo rojo) */
      .theme-light-text {
        color: #ffffff;
        text-shadow: 0 2px 14px rgba(0, 0, 0, 0.38);
      }

      /* Tema oscuro (texto oscuro sobre fondos blanco y papel texturizado) */
      .theme-dark-text {
        color: #1c1c1e;
        text-shadow: 0 1px 1px rgba(255, 255, 255, 0.8);
      }

      /* Adaptación Responsive: Tablet vertical y Móvil */
      @media (max-width: 820px) {
        .bg-image {
          background-position: 78% 24%;
        }

        .quote-container {
          top: auto;
          bottom: 5.5rem;
          left: 50%;
          transform: translateX(-50%);
          width: 86vw;
          max-width: 480px;
          text-align: center;
          padding: 1.1rem 1.25rem;
          border-radius: 12px;
        }

        .theme-light-text.quote-container {
          background: rgba(20, 0, 0, 0.28);
          backdrop-filter: blur(4px);
          -webkit-backdrop-filter: blur(4px);
        }

        .theme-dark-text.quote-container {
          background: rgba(255, 255, 255, 0.45);
          backdrop-filter: blur(4px);
          -webkit-backdrop-filter: blur(4px);
        }

        .footer-contact {
          bottom: 1.6rem;
          left: 50%;
          transform: translateX(-50%);
          width: 100%;
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <div id="bg" class="bg-image"></div>

    <aside id="quote-container" class="quote-container">
      <span class="quote-kicker">Sunder Design · En construcción</span>
      <p id="quote-text" class="quote-text"></p>
      <span id="quote-sub" class="quote-sub"></span>
    </aside>

    <footer id="footer-contact" class="footer-contact">
      <a href="mailto:think@sunder.design" class="contact-link">think@sunder.design</a>
    </footer>

    <script>
      const fondos = [
        {
          src: '/fondo_web_logo_suprimira_under_construction.jpg',
          theme: 'theme-light-text',
          bgPos: '70% center'
        },
        {
          src: '/fondo_web_logo_suprimira_under_construction-3.jpg',
          theme: 'theme-dark-text',
          bgPos: '78% center'
        },
        {
          src: '/fondo_web_logo_suprimira_under_construction-4.jpg',
          theme: 'theme-dark-text',
          bgPos: '76% center'
        }
      ];

      const aperturas = [
        "Construir algo extraordinario",
        "La verdadera innovación",
        "Emprender con propósito",
        "Cada gran proyecto",
        "El diseño con intención",
        "Transformar una idea en realidad",
        "La excelencia en los detalles",
        "Crear desde cero"
      ];

      const nucleos = [
        "exige valentía para desafiar lo establecido",
        "nace cuando la disciplina supera a la duda",
        "consiste en ver oportunidades donde otros ven límites",
        "requiere paciencia en el proceso y audacia en la ejecución",
        "es el arte de simplificar lo complejo hasta hacerlo inevitable",
        "se mide por el impacto real que deja en las personas",
        "empieza mucho antes de que el mundo esté listo para verlo",
        "convierte la incertidumbre en tu mayor ventaja competitiva"
      ];

      const cierres = [
        "Estamos dando forma a lo que viene.",
        "El futuro se diseña hoy.",
        "La visión precede al resultado.",
        "Menos ruido, más esencia.",
        "Cada trazo cuenta.",
        "Lo mejor aún está por revelarse."
      ];

      function generarFraseIA() {
        const a = aperturas[Math.floor(Math.random() * aperturas.length)];
        const n = nucleos[Math.floor(Math.random() * nucleos.length)];
        const c = cierres[Math.floor(Math.random() * cierres.length)];
        return {
          principal: `${a} ${n}.`,
          subtitulo: c
        };
      }

      // 1. Seleccionar fondo aleatorio y aplicar su tema visual al texto y al correo
      const elegido = fondos[Math.floor(Math.random() * fondos.length)];
      const bgEl = document.getElementById('bg');
      const containerEl = document.getElementById('quote-container');
      const footerEl = document.getElementById('footer-contact');

      if (bgEl && containerEl && footerEl) {
        bgEl.style.backgroundImage = `url('${elegido.src}')`;
        bgEl.style.setProperty('--bg-pos', elegido.bgPos);
        containerEl.classList.add(elegido.theme);
        footerEl.classList.add(elegido.theme);
      }

      // 2. Generar e insertar la frase motivacional aleatoria
      const frase = generarFraseIA();
      const textEl = document.getElementById('quote-text');
      const subEl = document.getElementById('quote-sub');

      if (textEl && subEl) {
        textEl.textContent = frase.principal;
        subEl.textContent = frase.subtitulo;
      }
    </script>
  </body>
</html>