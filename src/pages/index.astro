---
// src/pages/index.astro
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sunder Design</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body, html {
        width: 100%;
        height: 100dvh;
        overflow: hidden;
        background-color: #111;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }

      .bg-image {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-repeat: no-repeat;
        z-index: 1;
        background-position: var(--bg-pos, 72% center);
        transition: opacity 0.5s ease;
      }

      /* Bloque tipográfico adaptable al lado libre */
      .quote-container {
        position: fixed;
        z-index: 2;
        top: 50%;
        transform: translateY(-50%);
        width: min(460px, 43vw);
        pointer-events: none;
        padding: 1.5rem 1.75rem;
        border-radius: 16px;
        transition: all 0.3s ease;
      }

      /* Alineación cuando el espacio libre está a la IZQUIERDA */
      .pos-left.quote-container {
        left: 6%;
        right: auto;
        text-align: left;
      }

      /* Alineación cuando el espacio libre está a la DERECHA */
      .pos-right.quote-container {
        right: 6%;
        left: auto;
        text-align: left;
      }

      .quote-kicker {
        display: block;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        margin-bottom: 1rem;
        opacity: 0.75;
      }

      .quote-text {
        font-size: clamp(1.25rem, 2.2vw, 1.85rem);
        font-weight: 300;
        line-height: 1.42;
        letter-spacing: -0.01em;
        margin-bottom: 1.1rem;
      }

      .quote-sub {
        display: block;
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.8;
      }

      /* Pie de página con enlace de contacto sincronizado con el lado libre */
      .footer-contact {
        position: fixed;
        z-index: 3;
        bottom: 2rem;
      }

      .pos-left.footer-contact {
        left: calc(6% + 1.75rem);
        right: auto;
      }

      .pos-right.footer-contact {
        right: calc(6% + 1.75rem);
        left: auto;
      }

      .contact-link {
        font-size: 0.85rem;
        font-weight: 400;
        letter-spacing: 0.12em;
        text-decoration: none;
        color: inherit;
        opacity: 0.8;
        border-bottom: 1px solid currentColor;
        padding-bottom: 3px;
        transition: opacity 0.25s ease;
      }

      .contact-link:hover {
        opacity: 1;
      }

      /* Tema claro (texto blanco sobre fondos oscuros, agua, selva, ladrillo, etc.) */
      .theme-light-text {
        color: #ffffff;
        text-shadow: 0 2px 16px rgba(0, 0, 0, 0.55);
      }

      .theme-light-text.quote-container {
        background: radial-gradient(circle at center, rgba(10, 10, 12, 0.34) 0%, rgba(10, 10, 12, 0.12) 100%);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
      }

      /* Tema oscuro (texto oscuro sobre fondos claros: blanco, papel, cielo, mármol claro) */
      .theme-dark-text {
        color: #18181b;
        text-shadow: 0 1px 12px rgba(255, 255, 255, 0.85);
      }

      .theme-dark-text.quote-container {
        background: radial-gradient(circle at center, rgba(255, 255, 255, 0.52) 0%, rgba(255, 255, 255, 0.2) 100%);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
      }

      /* Adaptación Responsive: Tablet vertical y Móvil */
      @media (max-width: 820px) {
        .bg-image {
          background-position: var(--bg-pos-mobile, 78% 24%);
        }

        .quote-container,
        .pos-left.quote-container,
        .pos-right.quote-container {
          top: auto;
          bottom: 5.2rem;
          left: 50%;
          right: auto;
          transform: translateX(-50%);
          width: 88vw;
          max-width: 480px;
          text-align: center;
          padding: 1.15rem 1.3rem;
          border-radius: 14px;
        }

        .theme-light-text.quote-container {
          background: rgba(15, 15, 18, 0.48);
          backdrop-filter: blur(6px);
          -webkit-backdrop-filter: blur(6px);
        }

        .theme-dark-text.quote-container {
          background: rgba(255, 255, 255, 0.65);
          backdrop-filter: blur(6px);
          -webkit-backdrop-filter: blur(6px);
        }

        .footer-contact,
        .pos-left.footer-contact,
        .pos-right.footer-contact {
          bottom: 1.6rem;
          left: 50%;
          right: auto;
          transform: translateX(-50%);
          width: 100%;
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <div id="bg" class="bg-image"></div>

    <aside id="quote-container" class="quote-container">
      <span class="quote-kicker">Sunder Design · En construcción</span>
      <p id="quote-text" class="quote-text"></p>
      <span id="quote-sub" class="quote-sub"></span>
    </aside>

    <footer id="footer-contact" class="footer-contact">
      <a href="mailto:think@sunder.design" class="contact-link">think@sunder.design</a>
    </footer>

    <script>
      // Catálogo completo de los 22 fondos con su lado libre, tema y encuadre
      const fondos = [
        { src: '/bck_00.jpg',  side: 'left',  theme: 'theme-dark-text',  bgPos: '78% center', bgPosMobile: '82% 25%' },
        { src: '/bck_01.jpg',  side: 'left',  theme: 'theme-light-text', bgPos: '76% center', bgPosMobile: '80% 25%' },
        { src: '/bck_02.jpg',  side: 'right', theme: 'theme-dark-text',  bgPos: '24% center', bgPosMobile: '20% 25%' },
        { src: '/bck_03.jpg',  side: 'left',  theme: 'theme-light-text', bgPos: '74% center', bgPosMobile: '78% 25%' },
        { src: '/bck_04.jpeg', side: 'left',  theme: 'theme-dark-text',  bgPos: '75% center', bgPosMobile: '78% 28%' },
        { src: '/bck_05.jpeg', side: 'right', theme: 'theme-light-text', bgPos: '25% center', bgPosMobile: '22% 28%' },
        { src: '/bck_06.jpeg', side: 'right', theme: 'theme-light-text', bgPos: '24% center', bgPosMobile: '20% 28%' },
        { src: '/bck_07.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '76% center', bgPosMobile: '78% 28%' },
        { src: '/bck_08.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '76% center', bgPosMobile: '78% 28%' },
        { src: '/bck_09.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '74% center', bgPosMobile: '76% 28%' },
        { src: '/bck_10.jpeg', side: 'left',  theme: 'theme-dark-text',  bgPos: '76% center', bgPosMobile: '78% 28%' },
        { src: '/bck_11.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '75% center', bgPosMobile: '78% 28%' },
        { src: '/bck_12.jpeg', side: 'right', theme: 'theme-light-text', bgPos: '26% center', bgPosMobile: '22% 28%' },
        { src: '/bck_13.jpeg', side: 'right', theme: 'theme-dark-text',  bgPos: '25% center', bgPosMobile: '22% 28%' },
        { src: '/bck_14.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '76% center', bgPosMobile: '78% 28%' },
        { src: '/bck_15.jpeg', side: 'right', theme: 'theme-light-text', bgPos: '25% center', bgPosMobile: '22% 28%' },
        { src: '/bck_16.jpeg', side: 'left',  theme: 'theme-dark-text',  bgPos: '76% center', bgPosMobile: '78% 28%' },
        { src: '/bck_17.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '78% center', bgPosMobile: '80% 28%' },
        { src: '/bck_18.jpeg', side: 'right', theme: 'theme-dark-text',  bgPos: '24% center', bgPosMobile: '20% 28%' },
        { src: '/bck_19.jpeg', side: 'left',  theme: 'theme-light-text', bgPos: '75% center', bgPosMobile: '78% 28%' },
        { src: '/bck_20.jpeg', side: 'right', theme: 'theme-dark-text',  bgPos: '25% center', bgPosMobile: '22% 28%' },
        { src: '/bck_21.jpeg', side: 'left',  theme: 'theme-dark-text',  bgPos: '76% center', bgPosMobile: '80% 28%' }
      ];

      const aperturas = [
        "Construir algo extraordinario",
        "La verdadera innovación",
        "Emprender con propósito",
        "Cada gran proyecto",
        "El diseño con intención",
        "Transformar una idea en realidad",
        "La excelencia en los detalles",
        "Crear desde cero"
      ];

      const nucleos = [
        "exige valentía para desafiar lo establecido",
        "nace cuando la disciplina supera a la duda",
        "consiste en ver oportunidades donde otros ven límites",
        "requiere paciencia en el proceso y audacia en la ejecución",
        "es el arte de simplificar lo complejo hasta hacerlo inevitable",
        "se mide por el impacto real que deja en las personas",
        "empieza mucho antes de que el mundo esté listo para verlo",
        "convierte la incertidumbre en tu mayor ventaja competitiva"
      ];

      const cierres = [
        "Estamos dando forma a lo que viene.",
        "El futuro se diseña hoy.",
        "La visión precede al resultado.",
        "Menos ruido, más esencia.",
        "Cada trazo cuenta.",
        "Lo mejor aún está por revelarse."
      ];

      function generarFraseIA() {
        const a = aperturas[Math.floor(Math.random() * aperturas.length)];
        const n = nucleos[Math.floor(Math.random() * nucleos.length)];
        const c = cierres[Math.floor(Math.random() * cierres.length)];
        return {
          principal: `${a} ${n}.`,
          subtitulo: c
        };
      }

      // 1. Seleccionar fondo aleatorio sin repetir el inmediatamente anterior (si es posible)
      const lastIndex = Number(sessionStorage.getItem('sunder_last_bg'));
      let randomIndex = Math.floor(Math.random() * fondos.length);
      if (fondos.length > 1 && randomIndex === lastIndex) {
        randomIndex = (randomIndex + 1) % fondos.length;
      }
      sessionStorage.setItem('sunder_last_bg', String(randomIndex));

      const elegido = fondos[randomIndex];
      const bgEl = document.getElementById('bg');
      const containerEl = document.getElementById('quote-container');
      const footerEl = document.getElementById('footer-contact');

      if (bgEl && containerEl && footerEl) {
        bgEl.style.backgroundImage = `url('${elegido.src}')`;
        bgEl.style.setProperty('--bg-pos', elegido.bgPos);
        bgEl.style.setProperty('--bg-pos-mobile', elegido.bgPosMobile);

        const sideClass = elegido.side === 'right' ? 'pos-right' : 'pos-left';
        containerEl.classList.add(elegido.theme, sideClass);
        footerEl.classList.add(elegido.theme, sideClass);
      }

      // 2. Generar e insertar la frase motivacional aleatoria
      const frase = generarFraseIA();
      const textEl = document.getElementById('quote-text');
      const subEl = document.getElementById('quote-sub');

      if (textEl && subEl) {
        textEl.textContent = frase.principal;
        subEl.textContent = frase.subtitulo;
      }
    </script>
  </body>
</html>